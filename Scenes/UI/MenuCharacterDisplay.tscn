[sub_resource type="Shader" id="ContactShadowShader"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, depth_draw_never;\nvoid fragment() {\n    vec2 centered = (UV - vec2(0.5)) * vec2(2.0);\n    float distance_from_center = length(centered);\n    float softness = 1.0 - smoothstep(0.16, 1.0, distance_from_center);\n    ALBEDO = vec3(0.055, 0.038, 0.018);\n    ALPHA = softness * 0.52;\n}\n"

